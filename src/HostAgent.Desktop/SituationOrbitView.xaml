<UserControl x:Class="HostAgent.Desktop.SituationOrbitView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 IsTabStop="False">
 <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"
         BorderThickness="1" CornerRadius="12" Padding="16">
  <StackPanel>
   <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <TextBlock x:Name="Description" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,12"/>
   <WrapPanel x:Name="StateLegend" Margin="0,0,0,8" KeyboardNavigation.TabNavigation="Once">
    <StackPanel Orientation="Horizontal" Margin="0,0,16,4"><Ellipse Width="10" Height="10" Fill="{DynamicResource GreenBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="{DynamicResource Loc.OrbitLegendCurrent}" TextWrapping="Wrap"/></StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,16,4"><Ellipse Width="10" Height="10" Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="{DynamicResource Loc.OrbitLegendPartial}" TextWrapping="Wrap"/></StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,16,4"><Ellipse Width="10" Height="10" Fill="{DynamicResource ErrorBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="{DynamicResource Loc.OrbitLegendUnavailable}" TextWrapping="Wrap"/></StackPanel>
   </WrapPanel>
   <Grid x:Name="Body">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailColumn" Width="0"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="Map" MinHeight="230" KeyboardNavigation.DirectionalNavigation="Contained" Grid.Row="0" Grid.Column="0">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="74"/><RowDefinition Height="Auto" MinHeight="74"/><RowDefinition Height="Auto" MinHeight="74"/></Grid.RowDefinitions>
     <Ellipse Grid.RowSpan="3" Grid.ColumnSpan="3" Margin="32,18" Stroke="{DynamicResource LineBrush}" IsHitTestVisible="False"/>
     <Canvas x:Name="Links" Grid.RowSpan="3" Grid.ColumnSpan="3" IsHitTestVisible="False"/>
     <Border x:Name="Center" Grid.Row="1" Grid.Column="1" Background="{DynamicResource AlternateBrush}"
             Padding="6" Margin="4" CornerRadius="20" VerticalAlignment="Center">
      <StackPanel>
       <TextBlock Text="Host Agent" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
       <TextBlock x:Name="CenterStatus" TextAlignment="Center" TextWrapping="Wrap" FontSize="12"/>
      </StackPanel>
     </Border>
    </Grid>
    <Border x:Name="Detail" Grid.Row="0" Grid.Column="1" Padding="12" Margin="12,0,0,0"
            Background="{DynamicResource AlternateBrush}" CornerRadius="8" Visibility="Visible">
     <StackPanel>
      <DockPanel LastChildFill="True">
       <Button x:Name="CloseDetail" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="8,5"
               Click="ToggleDetailClick" Content="×" ToolTip="{DynamicResource Loc.OrbitCloseDetail}"
               AutomationProperties.Name="{DynamicResource Loc.OrbitCloseDetail}"/>
       <TextBlock x:Name="DetailTitle" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
      </DockPanel>
      <StackPanel x:Name="DetailContent">
       <TextBlock x:Name="DetailStatus" TextWrapping="Wrap" Margin="0,6,0,0"/>
       <TextBlock x:Name="DetailSummary" TextWrapping="Wrap" Margin="0,4,0,0"/>
       <ItemsControl x:Name="DetailRows" Margin="0,6,0,0">
        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
     </StackPanel>
    </Border>
   </Grid>
   <Expander Header="{DynamicResource Loc.OrbitTextList}" Foreground="{DynamicResource InkBrush}" Margin="0,8,0,0">
    <WrapPanel x:Name="TextNodes" Margin="0,6,0,0"/>
   </Expander>
   <TextBlock x:Name="Source" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
   <TextBlock x:Name="SelectionAnnouncement" Text="" Height="1" Opacity="0" IsHitTestVisible="False" Focusable="False" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
 </Border>
</UserControl>
