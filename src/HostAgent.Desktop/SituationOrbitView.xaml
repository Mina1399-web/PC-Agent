<UserControl x:Class="HostAgent.Desktop.SituationOrbitView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 IsTabStop="False">
 <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"
         BorderThickness="1" CornerRadius="12" Padding="14">
  <StackPanel>
   <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <TextBlock x:Name="Description" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,8" FontSize="12"/>
   <Grid x:Name="Map" MinHeight="310" KeyboardNavigation.DirectionalNavigation="Contained">
    <Ellipse Margin="62,41" Stroke="{DynamicResource LineBrush}" StrokeThickness="1.2" IsHitTestVisible="False"/>
    <Ellipse Margin="103,65" Stroke="{DynamicResource LineBrush}" StrokeThickness="1" Opacity="0.55" IsHitTestVisible="False"/>
    <Canvas x:Name="Links" IsHitTestVisible="False"/>
    <Canvas x:Name="OrbitNodes" IsHitTestVisible="True"/>
    <Border x:Name="Center" Width="132" Height="76" HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="{DynamicResource AlternateBrush}" BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1" Padding="8" Margin="4" CornerRadius="28">
     <StackPanel>
      <TextBlock Text="Host Agent" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
      <TextBlock x:Name="CenterStatus" TextAlignment="Center" TextWrapping="Wrap" FontSize="12"/>
     </StackPanel>
    </Border>
   </Grid>
   <Expander Header="{DynamicResource Loc.OrbitTextList}" Foreground="{DynamicResource InkBrush}" Margin="0,8,0,0">
    <WrapPanel x:Name="TextNodes" Margin="0,6,0,0"/>
   </Expander>
   <TextBlock x:Name="Source" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
  </StackPanel>
 </Border>
</UserControl>
