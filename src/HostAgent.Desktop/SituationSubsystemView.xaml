<UserControl x:Class="HostAgent.Desktop.SituationSubsystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" IsTabStop="False" PreviewKeyDown="HandleKey"
             SizeChanged="UpdateLayoutForWidth">
    <UserControl.Resources>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                            <Control x:Name="KeyboardFocusOutline" Style="{DynamicResource FocusRing}"
                                     Focusable="False" IsTabStop="False" IsHitTestVisible="False"
                                     Visibility="Collapsed"/>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                <Setter TargetName="KeyboardFocusOutline" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Style="{DynamicResource Card}">
        <StackPanel>
            <TextBlock Text="{DynamicResource Loc.SubsystemHeading}" Style="{DynamicResource SectionTitle}"/>
            <Grid x:Name="Body" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="DetailColumn" Width="0"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Loc.SubsystemMap}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <UniformGrid x:Name="Map" Columns="2" KeyboardNavigation.TabNavigation="Once" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource Loc.SubsystemList}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <StackPanel x:Name="SubsystemList" KeyboardNavigation.TabNavigation="Once"/>
                    <CheckBox x:Name="ShowDetail" Content="{DynamicResource Loc.SubsystemShowDetail}"
                              Foreground="{DynamicResource InkBrush}" Checked="ToggleDetail" Unchecked="ToggleDetail"
                              HorizontalAlignment="Left" Padding="8,4"/>
                </StackPanel>
                <Border x:Name="Detail" Grid.Row="1" Visibility="Collapsed"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12"
                        Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock x:Name="DetailTitle" TextWrapping="Wrap" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DetailStatus" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock x:Name="DetailValue" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <Button Content="{DynamicResource Loc.SubsystemCloseDetail}" Click="CloseDetail"
                                HorizontalAlignment="Left" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
