<Window x:Class="HostAgent.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:HostAgent.Desktop"
 Title="{DynamicResource Loc.HostAgentComputerStatus}" Width="1280" Height="880" MinWidth="850" MinHeight="620"
 Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource InkBrush}" FontFamily="Segoe UI" FontSize="16" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Themes/OrbitLight.xaml"/>
    <ResourceDictionary Source="Themes/OrbitControls.xaml"/>
   </ResourceDictionary.MergedDictionaries>
  <local:ByteSizeConverter x:Key="Bytes"/>
  <local:IncidentStateConverter x:Key="IncidentState"/>
  <local:TechnicalTextConverter x:Key="TechnicalText"/>
  <local:TelemetryExplanationConverter x:Key="TelemetryExplanation"/>
  <Style TargetType="ScrollBar">
   <Style.Triggers><Trigger Property="Orientation" Value="Vertical">
    <Setter Property="Width" Value="12"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
     <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
      <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb MinHeight="28"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" Background="{DynamicResource InputBorderBrush}" CornerRadius="4" Margin="3,0"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
     </Track>
    </ControlTemplate></Setter.Value></Setter>
   </Trigger></Style.Triggers>
  </Style>
  <Style x:Key="GridText" TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontSize" Value="16"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="24"/></Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20"/></Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="Padding" Value="12,8"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="{DynamicResource CardBrush}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource AlternateBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource AlternateBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="Padding" Value="12,8"/><Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="ComboSurface" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6"><TextBlock Text="⌄" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
    </ToggleButton>
    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="12,8,30,8" IsHitTestVisible="False" VerticalAlignment="Center"/>
    <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="300"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
   </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/>
   <Setter Property="CanUserReorderColumns" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
   <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource LineBrush}"/><Setter Property="MinRowHeight" Value="44"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="RowBackground" Value="{DynamicResource CardBrush}"/><Setter Property="Background" Value="{DynamicResource CardBrush}"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource AlternateBrush}"/><Setter Property="RowHeaderWidth" Value="0"/>
   <Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/>
  </Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource CanvasBrush}"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Content}"/></Style>
  <Style TargetType="DataGridCell"><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectedBrush}"/><Setter Property="Foreground" Value="{DynamicResource RailTextBrush}"/></Trigger></Style.Triggers><Setter Property="Padding" Value="12,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Background" Value="{DynamicResource SelectedBrush}"/><Setter Property="Foreground" Value="{DynamicResource RailTextBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Label"><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/></Style>
  <Style TargetType="Expander"><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/></Style>
  <Style TargetType="ToolTip"><Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="Padding" Value="12,8"/></Style>
  <Style TargetType="DataGridRow">
   <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
   <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectedBrush}"/><Setter Property="Foreground" Value="{DynamicResource RailTextBrush}"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="ProgressBar">
   <Setter Property="Height" Value="4"/><Setter Property="Maximum" Value="100"/><Setter Property="Focusable" Value="False"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="Background" Value="{DynamicResource LineBrush}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid><Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2"/><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2"/></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabItem">
   <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="FontSize" Value="15"/><Setter Property="Margin" Value="8,3"/><Setter Property="Padding" Value="10,12"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Nav" CornerRadius="6" BorderThickness="3,0,0,0" BorderBrush="Transparent" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Nav" Property="Background" Value="{DynamicResource SelectedBrush}"/><Setter TargetName="Nav" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Nav" Property="TextElement.FontWeight" Value="SemiBold"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Nav" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Nav" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Nav" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Nav" Property="Opacity" Value="0.62"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  </ResourceDictionary>
 </Window.Resources>
 <Grid Background="{DynamicResource CanvasBrush}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="176"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Grid.RowSpan="2" Background="{DynamicResource RailBrush}"/>
   <StackPanel Margin="20,24,16,24">
    <StackPanel Orientation="Horizontal"><Border Background="#31564B" CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="#FAF9F4" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Host Agent" FontSize="20" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/></StackPanel>
   <TextBlock Text="{DynamicResource Loc.LOCALMONITOR}" FontSize="11" Foreground="{DynamicResource RailTextBrush}" Margin="0,12,0,0"/>
  </StackPanel>
  <StackPanel Grid.Column="1" Margin="28,24,28,12">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="ThemeButton" Click="ThemeClick" Content="{DynamicResource Loc.DesignLightTheme}" ToolTip="{DynamicResource Loc.DesignThemeSession}" AutomationProperties.Name="{DynamicResource Loc.DesignTheme}" Padding="12,8"/><Label Content="{DynamicResource Loc.InterfaceLanguage}" Target="{Binding ElementName=LanguageChoice}" VerticalAlignment="Center"/><ComboBox x:Name="LanguageChoice" ItemsSource="{x:Null}" DisplayMemberPath="NativeName" SelectedValuePath="Code" Width="125" Margin="0,0,0,8" AutomationProperties.Name="{DynamicResource Loc.InterfaceLanguage}"/></StackPanel>
    <StackPanel MinWidth="90"><TextBlock x:Name="WorkspaceTitle" Text="{DynamicResource Loc.Workspace}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/><TextBlock Text="{DynamicResource Loc.ThisComputer}" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel>
   </DockPanel>
    <WrapPanel Margin="0,8,0,0"><Button x:Name="RefreshButton" ToolTip="F5" Content="{DynamicResource Loc.Refresh}" Click="RefreshClick"/><Button x:Name="DesktopModeButton" Content="{DynamicResource Loc.DesignModeStandardActive}" Click="DesktopModeClick" AutomationProperties.Name="{DynamicResource Loc.DesignModeStandardActive}"/></WrapPanel>
   <Border x:Name="StatusBanner" Background="{DynamicResource SelectedBrush}" CornerRadius="6" Padding="12,10" Margin="0,8,0,0"><TextBlock x:Name="StatusText" Foreground="{DynamicResource RailTextBrush}" Text="{DynamicResource Loc.ConnectingToTheLocalService}" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite"/></Border>
  </StackPanel>
   <TabControl x:Name="DashboardTabs" SelectionChanged="WindowsDashboardTabChanged" Grid.Row="1" Grid.ColumnSpan="2" Background="Transparent" BorderThickness="0" TabStripPlacement="Left">
   <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="176"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <DockPanel><Border x:Name="NavigationFooter" DockPanel.Dock="Bottom" Margin="20,20,20,24" BorderBrush="#3E536F" BorderThickness="0,1,0,0" Padding="8,20,8,0"><StackPanel><TextBlock Text="{DynamicResource Loc.UnderYourControl}" Foreground="White" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="{DynamicResource Loc.ActionsRequireApprovalTheDashboardDoesNotStopServices}" Foreground="{DynamicResource RailTextBrush}" TextWrapping="Wrap" FontSize="12" LineHeight="19" Margin="0,8,0,0"/></StackPanel></Border><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"><StackPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" VerticalAlignment="Top"/></ScrollViewer></DockPanel>
     <ContentPresenter Grid.Column="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="18,12,18,0"/>
   </Grid></ControlTemplate></TabControl.Template>
    <TabItem AutomationProperties.Name="{DynamicResource Loc.DesignNavSituation}">
     <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource RailTextBrush}" Width="24" VerticalAlignment="Center"/><TextBlock TextWrapping="Wrap" MaxWidth="112" Text="{DynamicResource Loc.DesignNavSituation}" Foreground="{DynamicResource RailTextBrush}"/></StackPanel></TabItem.Header>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,12,28">
      <TextBlock Text="{DynamicResource Loc.DesignSituationTitle}" FontSize="28" FontWeight="SemiBold"/>
      <TextBlock Text="{DynamicResource Loc.DesignSituationIntro}" Style="{StaticResource Caption}" Margin="0,4,0,12"/>
      <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3,0,0,0" Padding="16" Margin="0,0,0,16">
      <StackPanel>
       <TextBlock Text="{DynamicResource Loc.DesignAttention}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
       <TextBlock x:Name="TriageIncidentText" Text="{DynamicResource Loc.DesignEvidenceUnavailable}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,6"/>
       <TextBlock x:Name="TriageActionText" Text="{DynamicResource Loc.DesignRefreshFirst}" Style="{StaticResource Caption}"/>
        <TextBlock x:Name="TriageEvidenceMetaText" Text="{DynamicResource Loc.DesignEvidenceSourceUnavailable}" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
       <TextBlock x:Name="TriageDiskText" Style="{StaticResource Caption}" Foreground="{DynamicResource WarningBrush}" Margin="0,8,0,0" Visibility="Collapsed"/>
        <WrapPanel Margin="0,16,0,0"><Button x:Name="TriageActionButton" Style="{StaticResource PrimaryButton}" Content="{DynamicResource Loc.DesignRefreshMeasurementsButton}" Tag="refresh" Click="TriageActionClick" Padding="12,8" Margin="0,0,8,0"/></WrapPanel>
      </StackPanel>
     </Border>
     <TextBlock x:Name="HealthSummaryText" Text="{DynamicResource Loc.HealthSummaryConnecting}" Style="{StaticResource Caption}" Margin="0,0,0,16" AutomationProperties.LiveSetting="Polite"/>
     <UniformGrid x:Name="MetricsGrid" Columns="4" Margin="0,0,-12,8">
      <Border Style="{StaticResource Card}" Margin="0,0,12,12"><StackPanel><TextBlock Text="{DynamicResource Loc.Processor}" Style="{StaticResource Caption}"/><TextBlock x:Name="CpuText" Text="—" FontSize="32" FontWeight="SemiBold" Margin="0,10,0,8"/><TextBlock Text="{DynamicResource Loc.TotalCPUUtilization}" Style="{StaticResource Caption}" FontSize="12"/><ProgressBar x:Name="CpuMeter" Visibility="Hidden" Foreground="{DynamicResource AccentBrush}" Margin="0,16,0,0" AutomationProperties.Name="{DynamicResource Loc.TotalCPUUtilization}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,12,12"><StackPanel><TextBlock Text="{DynamicResource Loc.RAM}" Style="{StaticResource Caption}"/><TextBlock x:Name="MemoryText" Foreground="{DynamicResource RamBrush}" Text="—" FontSize="32" FontWeight="SemiBold" Margin="0,10,0,8"/><TextBlock Text="{DynamicResource Loc.PhysicalMemoryUsage}" Style="{StaticResource Caption}" FontSize="12"/><ProgressBar x:Name="MemoryMeter" Visibility="Hidden" Foreground="{DynamicResource RamBrush}" Margin="0,16,0,0" AutomationProperties.Name="{DynamicResource Loc.PhysicalMemoryUsage}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,12,12"><StackPanel><TextBlock Text="{DynamicResource Loc.Uptime}" Style="{StaticResource Caption}"/><TextBlock x:Name="UptimeText" Text="—" FontSize="23" FontWeight="SemiBold" Margin="0,16,0,12" TextWrapping="Wrap"/><TextBlock Text="{DynamicResource Loc.SinceWindowsStarted}" Style="{StaticResource Caption}" FontSize="12"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,12,12"><StackPanel><TextBlock Text="{DynamicResource Loc.OpenIncidents}" Style="{StaticResource Caption}"/><TextBlock x:Name="IncidentCountText" Text="—" FontSize="32" FontWeight="SemiBold" Margin="0,10,0,8"/><TextBlock Text="{DynamicResource Loc.InTheLatest20Records}" Style="{StaticResource Caption}" FontSize="12"/></StackPanel></Border>
     </UniformGrid>
     <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
      <DockPanel><TextBlock Text="{DynamicResource Loc.PerformanceHistory}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{DynamicResource Loc.Text24Hours}" Style="{StaticResource Caption}" HorizontalAlignment="Right"/></DockPanel>
      <DockPanel Margin="0,0,0,20"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><TextBlock Text="● CPU" Foreground="{DynamicResource AccentBrush}" Margin="12,0,16,0"/><TextBlock Text="● RAM" Foreground="{DynamicResource RamBrush}"/></StackPanel><TextBlock Text="{DynamicResource Loc.Text15MinuteAveragesGapsInMeasurementsRemainVisible}" Style="{StaticResource Caption}"/></DockPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid Height="180"><TextBlock Text="100 %" Style="{StaticResource Caption}" FontSize="11"/><TextBlock Text="50 %" Style="{StaticResource Caption}" FontSize="11" VerticalAlignment="Center"/><TextBlock Text="0 %" Style="{StaticResource Caption}" FontSize="11" VerticalAlignment="Bottom"/></Grid>
       <Canvas Grid.Column="1" x:Name="Chart" Height="180" Background="{DynamicResource CardBrush}" ClipToBounds="True" SizeChanged="ChartSizeChanged" AutomationProperties.Name="{DynamicResource Loc.CPUAndRAMHistoryOver24Hours}"/>
       <TextBlock Grid.Column="1" x:Name="ChartEmptyText" MaxWidth="360" Margin="16" Text="{DynamicResource Loc.HistoryIsNotAvailableYetTheChartWillAppearWhenSavedMeasurementsAreAv}" Style="{StaticResource Caption}" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>
      </Grid>
      <Grid Margin="38,10,0,0"><TextBlock Text="{DynamicResource Loc.Text24HAgo}" Style="{StaticResource Caption}" FontSize="11"/><TextBlock Text="{DynamicResource Loc.Text12HAgo}" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Center"/><TextBlock Text="{DynamicResource Loc.Now}" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Right"/></Grid>
     </StackPanel></Border>
     <Border Background="{DynamicResource SelectedBrush}" CornerRadius="6" Padding="14,12" Margin="0,0,0,16"><TextBlock x:Name="NetworkText" Foreground="{DynamicResource RailTextBrush}" Text="{DynamicResource Loc.NetworkWaitingForMeasurements}" TextWrapping="Wrap" FontSize="13"/></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="{DynamicResource Loc.Storage}" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="DisksEmptyText" Text="{DynamicResource Loc.DiskCapacitiesAreNotAvailableYet}" Style="{StaticResource Caption}" Margin="0,0,0,12"/>
      <DataGrid x:Name="DisksGrid" MaxHeight="210" AutomationProperties.Name="{DynamicResource Loc.DiskCapacityAndFreeSpace}"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource GridText}" local:DesktopLocalization.HeaderKey="Disk" Binding="{Binding Drive}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" local:DesktopLocalization.HeaderKey="FreeSpace" Binding="{Binding FreeBytes, Converter={StaticResource Bytes}}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" local:DesktopLocalization.HeaderKey="TotalCapacity" Binding="{Binding CapacityBytes, Converter={StaticResource Bytes}}" Width="*"/></DataGrid.Columns></DataGrid>
      <Button x:Name="SmartReadButton" Content="{DynamicResource Loc.ReadSmartPrediction}" Click="SmartClick" HorizontalAlignment="Left" Margin="0,10,0,4"/>
      <TextBlock x:Name="SmartResultText" Text="{DynamicResource Loc.SmartNotRead}" TextWrapping="Wrap"/>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource Loc.ProcessesUsingTheMostRAM}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{DynamicResource Loc.SelectingAProcessFillsInItsExactIdentityForTheManualAction}" Style="{StaticResource Caption}" Margin="0,0,0,12"/>
      <TextBlock x:Name="ProcessesEmptyText" Text="{DynamicResource Loc.ProcessDataIsNotAvailableYet}" Style="{StaticResource Caption}"/>
      <DataGrid x:Name="ProcessGrid" Height="250" AutomationProperties.Name="{DynamicResource Loc.ProcessesByMemoryUsage}"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource GridText}" local:DesktopLocalization.HeaderKey="Process" Binding="{Binding Name}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="PID" Binding="{Binding Pid}" Width="80"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="CPU %" Binding="{Binding CpuPercent, StringFormat=F1, TargetNullValue=—}" Width="85"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" local:DesktopLocalization.HeaderKey="Memory" Binding="{Binding MemoryBytes, Converter={StaticResource Bytes}}" Width="120"/></DataGrid.Columns></DataGrid>
     </StackPanel></Border>
    </StackPanel></ScrollViewer>
   </TabItem>
    <TabItem AutomationProperties.Name="{DynamicResource Loc.DesignNavEvents}"><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource RailTextBrush}" Width="24" VerticalAlignment="Center"/><TextBlock TextWrapping="Wrap" MaxWidth="112" Text="{DynamicResource Loc.DesignNavEvents}" Foreground="{DynamicResource RailTextBrush}"/></StackPanel></TabItem.Header>
    <Grid Margin="0,0,12,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*" MinHeight="100"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,20"><TextBlock Text="{DynamicResource Loc.IncidentsAndEvidence}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Loc.TheLatest20RecordsSelectAnIncidentToReviewItsEvidence}" Style="{StaticResource Caption}" Margin="0,6,0,12"/><TextBlock x:Name="IncidentsEmptyText" Text="{DynamicResource Loc.WaitingForSavedIncidents}" Style="{StaticResource Caption}"/></StackPanel>
      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8"><DataGrid x:Name="IncidentsGrid" SelectionChanged="IncidentSelected" AutomationProperties.Name="{DynamicResource Loc.RecentIncidents}"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource GridText}" local:DesktopLocalization.HeaderKey="UTCTime" Binding="{Binding AtUtc, StringFormat=g}" Width="180"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" local:DesktopLocalization.HeaderKey="CauseCode" Binding="{Binding Code, Converter={StaticResource TechnicalText}}" Width="*" MinWidth="230"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" local:DesktopLocalization.HeaderKey="DesignSeverity" Binding="{Binding Severity, Converter={StaticResource TechnicalText}, ConverterParameter=Label}" Width="135"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" local:DesktopLocalization.HeaderKey="Status" Binding="{Binding State, Converter={StaticResource IncidentState}}" Width="140"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" local:DesktopLocalization.HeaderKey="DesignClassification" Binding="{Binding Confidence}" Width="130"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" local:DesktopLocalization.HeaderKey="Occurrences" Binding="{Binding Recurrences}" Width="75"/></DataGrid.Columns></DataGrid></Border>
     <Button Grid.Row="2" Content="{DynamicResource Loc.ExportIncident}" ToolTip="{DynamicResource Loc.SaveALocalJSONFileWithLimitedEvidence}" Click="ExportClick" HorizontalAlignment="Left" Margin="0,16,0,16"/>
     <TextBox Grid.Row="3" x:Name="DetailText" MinHeight="70" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="20" AutomationProperties.Name="{DynamicResource Loc.IncidentDetailsAndLimitedEvidence}" Text="{DynamicResource Loc.SelectAnIncidentToViewTheAvailableCodesTimesAndNumericEvidence}"/>
     <Expander Grid.Row="4" x:Name="TechnicalDetailsExpander" Header="{DynamicResource Loc.TechnicalDetails}" Margin="0,8,0,0" Visibility="Collapsed"><TextBlock x:Name="TechnicalIncidentCodeText" TextWrapping="Wrap" Margin="12" AutomationProperties.Name="{DynamicResource Loc.TechnicalDetails}"/></Expander>
    </Grid>
   </TabItem>
    <TabItem AutomationProperties.Name="{DynamicResource Loc.Recommendations}"><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource RailTextBrush}" Width="24" VerticalAlignment="Center"/><TextBlock TextWrapping="Wrap" MaxWidth="112" Text="{DynamicResource Loc.Recommendations}" Foreground="{DynamicResource RailTextBrush}"/></StackPanel></TabItem.Header>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,24"><TextBlock Text="{DynamicResource Loc.RecommendedSteps}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Loc.SuggestionsAreBasedOnMeasurementsEachIncludesTheReasonBenefitAndImpa}" Style="{StaticResource Caption}" Margin="0,6,0,20"/><StackPanel x:Name="RecommendationsPanel"/></StackPanel></ScrollViewer>
   </TabItem>
    <TabItem AutomationProperties.Name="{DynamicResource Loc.DesignNavSystem}"><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource RailTextBrush}" Width="24" VerticalAlignment="Center"/><TextBlock TextWrapping="Wrap" MaxWidth="112" Text="{DynamicResource Loc.DesignNavSystem}" Foreground="{DynamicResource RailTextBrush}"/></StackPanel></TabItem.Header>
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,24"><TextBlock Text="{DynamicResource Loc.DesignSystemTitle}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Loc.DesignSystemIntro}" Style="{StaticResource Caption}" Margin="0,6,0,20"/>
      <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="{DynamicResource Loc.DesignSystemReadings}" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="SystemEvidenceMetaText" Text="{DynamicResource Loc.DesignEvidenceSourceUnavailable}" Style="{StaticResource Caption}" Margin="0,0,0,12"/><UniformGrid Columns="2">
