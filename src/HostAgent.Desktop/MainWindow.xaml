<Window x:Class="HostAgent.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:HostAgent.Desktop"
 Title="{DynamicResource Loc.HostAgentComputerStatus}" Width="1280" Height="880" MinWidth="850" MinHeight="620"
 Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource InkBrush}" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Themes/OrbitDark.xaml"/>
    <ResourceDictionary Source="Themes/OrbitControls.xaml"/>
   </ResourceDictionary.MergedDictionaries>
  <local:ByteSizeConverter x:Key="Bytes"/>
  <local:IncidentStateConverter x:Key="IncidentState"/>
  <local:TechnicalTextConverter x:Key="TechnicalText"/>
  <local:TelemetryExplanationConverter x:Key="TelemetryExplanation"/>
  <Style x:Key="GridText" TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontSize" Value="13"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="19"/></Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="16"/></Style>
  <Style x:Key="FocusRing" TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate><Rectangle Margin="-3" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeDashArray="2 1" RadiusX="6" RadiusY="6"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,6,6"/><Setter Property="Background" Value="{DynamicResource CardBrush}"/>
   <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Background" Value="{DynamicResource AlternateBrush}"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/></Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="Padding" Value="12,8"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="{DynamicResource CardBrush}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource SelectedBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource SelectedBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="Padding" Value="12,8"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="ComboSurface" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6"><TextBlock Text="⌄" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
    </ToggleButton>
    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="12,8,30,8" IsHitTestVisible="False" VerticalAlignment="Center"/>
    <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="300"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
   </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ProgressBar">
   <Setter Property="Height" Value="4"/><Setter Property="Maximum" Value="100"/><Setter Property="Focusable" Value="False"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="Background" Value="{DynamicResource LineBrush}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid><Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2"/><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2"/></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabItem">
   <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="Width" Value="88"/><Setter Property="Margin" Value="2,2"/><Setter Property="Padding" Value="2,8"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Nav" CornerRadius="6" BorderThickness="3,0,0,0" BorderBrush="Transparent" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Nav" Property="Background" Value="{DynamicResource SelectedBrush}"/><Setter TargetName="Nav" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Nav" Property="TextElement.FontWeight" Value="SemiBold"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Nav" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Nav" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Nav" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Nav" Property="Opacity" Value="0.62"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
   </ResourceDictionary>
 </Window.Resources>
 <Grid Background="{DynamicResource CanvasBrush}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Grid.RowSpan="2" Background="{DynamicResource RailBrush}"/>
   <StackPanel Margin="6,12,6,8" HorizontalAlignment="Center">
    <Grid Width="36" Height="36" ToolTip="Host Agent">
     <Ellipse Margin="5,10" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"/>
     <Ellipse Width="22" Height="8" Stroke="{DynamicResource RamBrush}" StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center"><Ellipse.RenderTransform><RotateTransform Angle="-28"/></Ellipse.RenderTransform></Ellipse>
     <Ellipse Width="5" Height="5" Fill="{DynamicResource WarningBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"/>
    </Grid>
    <TextBlock Text="Host Agent" FontSize="12" Foreground="{DynamicResource RailTextBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"/>
    <TextBlock Text="{DynamicResource Loc.LOCALMONITOR}" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0"/>
  </StackPanel>
  <StackPanel Grid.Column="1" Margin="18,10,18,8">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="ThemeButton" Click="ThemeClick" Content="{DynamicResource Loc.DesignLightTheme}" ToolTip="{DynamicResource Loc.DesignThemeSession}" AutomationProperties.Name="{DynamicResource Loc.DesignTheme}" Padding="12,8"/><Label Content="{DynamicResource Loc.InterfaceLanguage}" Target="{Binding ElementName=LanguageChoice}" VerticalAlignment="Center"/><ComboBox x:Name="LanguageChoice" ItemsSource="{x:Null}" DisplayMemberPath="NativeName" SelectedValuePath="Code" Width="125" Margin="0,0,0,8" AutomationProperties.Name="{DynamicResource Loc.InterfaceLanguage}"/></StackPanel>
    <StackPanel MinWidth="90"><TextBlock x:Name="WorkspaceTitle" Text="{DynamicResource Loc.Workspace}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/><TextBlock Text="{DynamicResource Loc.ThisComputer}" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel>
   </DockPanel>
    <WrapPanel Margin="0,8,0,0"><Button x:Name="RefreshButton" ToolTip="F5" Content="{DynamicResource Loc.Refresh}" Click="RefreshClick"/><Button x:Name="DesktopModeButton" Content="{DynamicResource Loc.DesignModeStandardActive}" Click="DesktopModeClick" AutomationProperties.Name="{DynamicResource Loc.DesignModeStandardActive}"/></WrapPanel>
   <Border x:Name="StatusBanner" Background="{DynamicResource SelectedBrush}" CornerRadius="6" Padding="9,7" Margin="0,6,0,0"><TextBlock x:Name="StatusText" Text="{DynamicResource Loc.ConnectingToTheLocalService}" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite"/></Border>
  </StackPanel>
   <TabControl x:Name="DashboardTabs" SelectionChanged="WindowsDashboardTabChanged" Grid.Row="1" Grid.ColumnSpan="2" Background="Transparent" BorderThickness="0" TabStripPlacement="Left">
   <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <DockPanel><Border x:Name="NavigationFooter" DockPanel.Dock="Bottom" Margin="8,8,8,12" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0"><TextBlock Text="ⓘ" Foreground="{DynamicResource AccentBrush}" FontSize="18" TextAlignment="Center" ToolTip="{DynamicResource Loc.ActionsRequireApprovalTheDashboardDoesNotStopServices}" AutomationProperties.Name="{DynamicResource Loc.ActionsRequireApprovalTheDashboardDoesNotStopServices}"/></Border><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"><StackPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" VerticalAlignment="Top"/></ScrollViewer></DockPanel>
     <ContentPresenter Grid.Column="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="16,8,16,0"/>
   </Grid></ControlTemplate></TabControl.Template>
    <TabItem AutomationProperties.Name="{DynamicResource Loc.DesignNavSituation}">
     <TabItem.Header><StackPanel Orientation="Vertical" ToolTip="{DynamicResource Loc.DesignNavSituation}"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource RailTextBrush}" Width="24" TextAlignment="Center" HorizontalAlignment="Center"/><TextBlock TextWrapping="Wrap" MaxWidth="80" TextAlignment="Center" FontSize="12" Text="{DynamicResource Loc.DesignNavSituation}" Foreground="{DynamicResource RailTextBrush}"/></StackPanel></TabItem.Header>
    <Grid x:Name="SituationPage" Margin="0,0,0,12">
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ScrollViewer x:Name="SituationScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,8,16">
      <DockPanel Margin="0,0,0,12"><StackPanel><TextBlock Text="{DynamicResource Loc.DesignSituationTitle}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Loc.DesignSituationIntro}" Style="{StaticResource Caption}" Margin="0,2,0,0"/></StackPanel><TextBlock x:Name="HealthSummaryText" Text="{DynamicResource Loc.HealthSummaryConnecting}" Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center" TextAlignment="Right" AutomationProperties.LiveSetting="Polite"/></DockPanel>
      <Grid x:Name="SituationHeroLayout" SizeChanged="SituationHeroLayoutSizeChanged" Margin="0,0,0,12">
       <Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <local:SituationOrbitView x:Name="SituationOrbit" Grid.Column="0" Grid.Row="0" Margin="0,0,8,0"/>
       <Border x:Name="SubsystemDetailPanel" Grid.Column="1" Style="{StaticResource Card}" Padding="14">
        <StackPanel>
         <UniformGrid Columns="2" Margin="0,0,0,10">
          <Border Background="{DynamicResource AlternateBrush}" CornerRadius="8" Padding="9" Margin="0,0,5,0"><StackPanel><TextBlock Text="{DynamicResource Loc.Processor}" Style="{StaticResource Caption}" FontSize="11"/><TextBlock x:Name="CpuText" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0"/><ProgressBar x:Name="CpuMeter" Visibility="Hidden" AutomationProperties.Name="{DynamicResource Loc.TotalCPUUtilization}"/></StackPanel></Border>
          <Border Background="{DynamicResource AlternateBrush}" CornerRadius="8" Padding="9" Margin="5,0,0,0"><StackPanel><TextBlock Text="{DynamicResource Loc.RAM}" Style="{StaticResource Caption}" FontSize="11"/><TextBlock x:Name="MemoryText" Foreground="{DynamicResource RamBrush}" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0"/><ProgressBar x:Name="MemoryMeter" Visibility="Hidden" AutomationProperties.Name="{DynamicResource Loc.PhysicalMemoryUsage}"/></StackPanel></Border>
         </UniformGrid>
         <TextBlock Text="{DynamicResource Loc.OrbitSelected}" Style="{StaticResource Caption}"/>
         <TextBlock x:Name="SelectedSubsystemTitle" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0"/>
         <TextBlock x:Name="SelectedSubsystemStatus" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
         <TextBlock x:Name="SelectedSubsystemSummary" TextWrapping="Wrap" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0"/>
         <ItemsControl x:Name="SelectedSubsystemRows" Margin="0,6,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Caption}" Margin="0,2,0,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
         <TextBlock x:Name="NetworkText" Text="{DynamicResource Loc.NetworkWaitingForMeasurements}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed"/>
         <Border x:Name="SmartDetailPanel" Background="{DynamicResource AlternateBrush}" CornerRadius="8" Padding="10" Margin="0,10,0,0" Visibility="Collapsed"><StackPanel><Button x:Name="SmartReadButton" Content="{DynamicResource Loc.ReadSmartPrediction}" Click="SmartClick" HorizontalAlignment="Left"/><TextBlock x:Name="SmartResultText" Text="{DynamicResource Loc.SmartNotRead}" TextWrapping="Wrap" Style="{StaticResource Caption}"/></StackPanel></Border>
         <Border x:Name="HistoryPanel" Background="{DynamicResource AlternateBrush}" CornerRadius="8" Padding="10" Margin="0,12,0,0" Visibility="Collapsed">
          <StackPanel>
           <DockPanel><TextBlock Text="{DynamicResource Loc.PerformanceHistory}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{DynamicResource Loc.Text24Hours}" Style="{StaticResource Caption}" HorizontalAlignment="Right"/></DockPanel>
           <DockPanel Margin="0,0,0,8"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><TextBlock Text="● CPU" Foreground="{DynamicResource AccentBrush}" Margin="8,0,12,0"/><TextBlock Text="● RAM" Foreground="{DynamicResource RamBrush}"/></StackPanel><TextBlock Text="{DynamicResource Loc.Text15MinuteAveragesGapsInMeasurementsRemainVisible}" Style="{StaticResource Caption}"/></DockPanel>
           <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid Height="132"><TextBlock Text="100 %" Style="{StaticResource Caption}" FontSize="10"/><TextBlock Text="50 %" Style="{StaticResource Caption}" FontSize="10" VerticalAlignment="Center"/><TextBlock Text="0 %" Style="{StaticResource Caption}" FontSize="10" VerticalAlignment="Bottom"/></Grid><Canvas Grid.Column="1" x:Name="Chart" Height="132" Background="{DynamicResource CardBrush}" ClipToBounds="True" SizeChanged="ChartSizeChanged" AutomationProperties.Name="{DynamicResource Loc.CPUAndRAMHistoryOver24Hours}"/><TextBlock Grid.Column="1" x:Name="ChartEmptyText" MaxWidth="300" Margin="8" Text="{DynamicResource Loc.HistoryIsNotAvailableYetTheChartWillAppearWhenSavedMeasurementsAreAv}" Style="{StaticResource Caption}" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid>
           <Grid Margin="34,6,0,0"><TextBlock Text="{DynamicResource Loc.Text24HAgo}" Style="{StaticResource Caption}" FontSize="10"/><TextBlock Text="{DynamicResource Loc.Text12HAgo}" Style="{StaticResource Caption}" FontSize="10" HorizontalAlignment="Center"/><TextBlock Text="{DynamicResource Loc.Now}" Style="{StaticResource Caption}" FontSize="10" HorizontalAlignment="Right"/></Grid>
          </StackPanel>
         </Border>
        </StackPanel>
       </Border>
      </Grid>
      <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="3,0,0,0" Padding="12" Margin="0,0,0,10">
       <StackPanel>
        <DockPanel><TextBlock Text="{DynamicResource Loc.DesignAttention}" FontSize="15" FontWeight="SemiBold"/><Button x:Name="TriageActionButton" Style="{StaticResource PrimaryButton}" Content="{DynamicResource Loc.DesignRefreshMeasurementsButton}" Tag="refresh" Click="TriageActionClick" Padding="10,6"/></DockPanel>
        <TextBlock x:Name="TriageIncidentText" Text="{DynamicResource Loc.DesignEvidenceUnavailable}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,0"/>
        <TextBlock x:Name="TriageActionText" Text="{DynamicResource Loc.DesignRefreshFirst}" Style="{StaticResource Caption}"/>
        <TextBlock x:Name="TriageEvidenceMetaText" Text="{DynamicResource Loc.DesignEvidenceSourceUnavailable}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
        <TextBlock x:Name="TriageDiskText" Style="{StaticResource Caption}" Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0" Visibility="Collapsed"/>
       </StackPanel>
      </Border>
      <UniformGrid x:Name="MetricsGrid" Columns="2" Margin="0,0,0,10">
       <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="12"><StackPanel><TextBlock Text="{DynamicResource Loc.Uptime}" Style="{StaticResource Caption}"/><TextBlock x:Name="UptimeText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="0" Padding="12"><StackPanel><TextBlock Text="{DynamicResource Loc.OpenIncidents}" Style="{StaticResource Caption}"/><TextBlock x:Name="IncidentCountText" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="{DynamicResource Loc.InTheLatest20Records}" Style="{StaticResource Caption}" FontSize="11"/></StackPanel></Border>
      </UniformGrid>
      <Border Style="{StaticResource Card}" Margin="0,0,0,10"><StackPanel><TextBlock Text="{DynamicResource Loc.Storage}" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="DisksEmptyText" Text="{DynamicResource Loc.DiskCapacitiesAreNotAvailableYet}" Style="{StaticResource Caption}" Margin="0,0,0,8"/><DataGrid x:Name="DisksGrid" MaxHeight="180" AutomationProperties.Name="{DynamicResource Loc.DiskCapacityAndFreeSpace}"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource GridText}" local:DesktopLocalization.HeaderKey="Disk" Binding="{Binding Drive}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" local:DesktopLocalization.HeaderKey="FreeSpace" Binding="{Binding FreeBytes, Converter={StaticResource Bytes}}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" local:DesktopLocalization.HeaderKey="TotalCapacity" Binding="{Binding CapacityBytes, Converter={StaticResource Bytes}}" Width="*"/></DataGrid.Columns></DataGrid></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource Loc.ProcessesUsingTheMostRAM}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{DynamicResource Loc.SelectingAProcessFillsInItsExactIdentityForTheManualAction}" Style="{StaticResource Caption}" Margin="0,0,0,8"/><TextBlock x:Name="ProcessesEmptyText" Text="{DynamicResource Loc.ProcessDataIsNotAvailableYet}" Style="{StaticResource Caption}"/><DataGrid x:Name="ProcessGrid" Height="220" AutomationProperties.Name="{DynamicResource Loc.ProcessesByMemoryUsage}"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource GridText}" local:DesktopLocalization.HeaderKey="Process" Binding="{Binding Name}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="PID" Binding="{Binding Pid}" Width="70"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="CPU %" Binding="{Binding CpuPercent, StringFormat=F1, TargetNullValue=—}" Width="75"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" local:DesktopLocalization.HeaderKey="Memory" Binding="{Binding MemoryBytes, Converter={StaticResource Bytes}}" Width="100"/></DataGrid.Columns></DataGrid></StackPanel></Border>
     </StackPanel></ScrollViewer>
     <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10,8" Margin="0,8,8,0" AutomationProperties.Name="{DynamicResource Loc.RecentIncidents}">
      <DockPanel LastChildFill="True"><Button DockPanel.Dock="Right" Content="{DynamicResource Loc.DesignNavEvents}" Click="OpenRecentEvents" Margin="8,0,0,0" Padding="8,5"/><StackPanel><TextBlock Text="{DynamicResource Loc.RecentIncidents}" FontWeight="SemiBold" FontSize="13"/><TextBlock x:Name="RecentActivityEmpty" Text="{DynamicResource Loc.WaitingForSavedIncidents}" Style="{StaticResource Caption}" FontSize="11" Margin="0,4,0,0"/><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,5,0,0"><ItemsControl x:Name="RecentActivityItems"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Click="RecentIncidentClick" Tag="{Binding Id}" ToolTip="{Binding Code}" AutomationProperties.Name="{Binding Code}" Margin="0,0,8,0" Padding="8,5" MinWidth="145"><StackPanel><TextBlock Text="{Binding AtUtc, StringFormat={}{0:t}}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Code, Converter={StaticResource TechnicalText}}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding State, Converter={StaticResource IncidentState}}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></StackPanel></DockPanel>
     </Border>
    </Grid>
   </TabItem>
    <TabItem AutomationProperties.Name="{DynamicResource Loc.DesignNavEvents}"><TabItem.Header><StackPanel Orientation="Vertical" ToolTip="{DynamicResource Loc.DesignNavEvents}"><TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource RailTextBrush}" Width="24" TextAlignment="Center" HorizontalAlignment="Center"/><TextBlock TextWrapping="Wrap" MaxWidth="80" TextAlignment="Center" FontSize="12" Text="{DynamicResource Loc.DesignNavEvents}" Foreground="{DynamicResource RailTextBrush}"/></StackPanel></TabItem.Header>
    <Grid Margin="0,0,12,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*" MinHeight="100"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,20"><TextBlock Text="{DynamicResource Loc.IncidentsAndEvidence}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Loc.TheLatest20RecordsSelectAnIncidentToReviewItsEvidence}" Style="{StaticResource Caption}" Margin="0,6,0,12"/><TextBlock x:Name="IncidentsEmptyText" Text="{DynamicResource Loc.WaitingForSavedIncidents}" Style="{StaticResource Caption}"/></StackPanel>
     <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8"><DataGrid x:Name="IncidentsGrid" SelectionChanged="IncidentSelected" AutomationProperties.Name="{DynamicResource Loc.RecentIncidents}"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource GridText}" local:DesktopLocalization.HeaderKey="UTCTime" Binding="{Binding AtUtc, StringFormat=g}" Width="116"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" local:DesktopLocalization.HeaderKey="CauseCode" Binding="{Binding Code, Converter={StaticResource TechnicalText}}" Width="*" MinWidth="160"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" local:DesktopLocalization.HeaderKey="DesignSeverity" Binding="{Binding Severity, Converter={StaticResource TechnicalText}, ConverterParameter=Label}" Width="100"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" local:DesktopLocalization.HeaderKey="Status" Binding="{Binding State, Converter={StaticResource IncidentState}}" Width="110"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" local:DesktopLocalization.HeaderKey="DesignClassification" Binding="{Binding Confidence}" Width="88"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" local:DesktopLocalization.HeaderKey="Occurrences" Binding="{Binding Recurrences}" Width="70"/></DataGrid.Columns></DataGrid></Border>
     <Button Grid.Row="2" Content="{DynamicResource Loc.ExportIncident}" ToolTip="{DynamicResource Loc.SaveALocalJSONFileWithLimitedEvidence}" Click="ExportClick" HorizontalAlignment="Left" Margin="0,16,0,16"/>
     <TextBox Grid.Row="3" x:Name="DetailText" MinHeight="70" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="20" AutomationProperties.Name="{DynamicResource Loc.IncidentDetailsAndLimitedEvidence}" Text="{DynamicResource Loc.SelectAnIncidentToViewTheAvailableCodesTimesAndNumericEvidence}"/>
     <Expander Grid.Row="4" x:Name="TechnicalDetailsExpander" Header="{DynamicResource Loc.TechnicalDetails}" Margin="0,8,0,0" Visibility="Collapsed"><TextBlock x:Name="TechnicalIncidentCodeText" TextWrapping="Wrap" Margin="12" AutomationProperties.Name="{DynamicResource Loc.TechnicalDetails}"/></Expander>
    </Grid>
   </TabItem>
